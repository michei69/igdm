{
  "name": "igdm",
  "private": true,
  "version": "0.1.0",
  "description": "IG Direct — Instagram DM desktop client (Tauri 2 + React)",
  "scripts": {
    "dev": "cd crates/igdm && tauri dev",
    "build": "cd crates/igdm && tauri build",
    "build:linux": "cd crates/igdm && NO_STRIP=1 tauri build --bundles deb,rpm,appimage && cd ../.. && scripts/package-linux.sh",
    "build:flatpak": "bash scripts/build-flatpak.sh",
    "build:snap": "bash scripts/build-snap.sh",
    "package:linux": "bash scripts/package-linux.sh",
    "run": "cargo run -p igdm",
    "typecheck": "bun run --cwd crates/igdm/ui typecheck",
    "lint": "bun run --cwd crates/igdm/ui lint",
    "format:check": "bun run --cwd crates/igdm/ui format:check",
    "doctor": "bun run --cwd crates/igdm/ui doctor",
    "frontend:install": "bun install --cwd crates/igdm/ui",
    "frontend:build": "bun run --cwd crates/igdm/ui build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1"
  }
}
